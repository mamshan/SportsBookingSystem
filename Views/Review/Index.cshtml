@model IEnumerable<Review>
@{ ViewData["Title"] = "Facility reviews"; }
<h1>Facility reviews</h1>
@if (Context.Session.GetInt32("MemberID") != null) { <p><a class="btn btn-primary" asp-action="Create">Write a review</a></p> }
<form method="get" class="row g-3 mb-4">
    <div class="col-md-5"><label for="facilityId">Facility</label><select id="facilityId" name="facilityId" asp-items="ViewBag.Facilities" class="form-select"><option value="">All facilities</option></select></div>
    <div class="col-md-3"><label for="rating">Rating</label><select name="rating" id="rating" class="form-select"><option value="">All ratings</option>
        @for (var i = 1; i <= 5; i++) { <option value="@i" selected="@(ViewBag.Rating == i)">@i / 5</option> }
    </select></div>
    <div class="col-md-4 align-self-end"><button class="btn btn-primary">Search</button> <a asp-action="Index" class="btn btn-secondary">Clear</a></div>
</form>
@if (!Model.Any()) { <p>No reviews match your search.</p> }
@foreach (var review in Model)
{
    <div class="border rounded p-3 mb-3">
        <h2 class="h5">@review.Facility.Name — @review.Rating / 5</h2>
        <p>@review.Comments</p>
        <small>@review.Member.Name · @review.ReviewDate?.ToString("dd MMM yyyy")</small>
    </div>
}
