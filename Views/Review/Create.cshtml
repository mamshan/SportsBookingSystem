@model ReviewViewModel
@{ ViewData["Title"] = "Write a review"; }
<h1>Write a review</h1>
<p>You can review facilities after a confirmed booking has ended. If none appear, you have no eligible bookings yet.</p>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FacilityId"></label><select asp-for="FacilityId" asp-items="ViewBag.Facilities" class="form-select"><option value="">Choose a facility</option></select><span asp-validation-for="FacilityId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Rating"></label><input asp-for="Rating" type="number" min="1" max="5" class="form-control" /><span asp-validation-for="Rating" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Comments"></label><textarea asp-for="Comments" class="form-control" rows="4"></textarea><span asp-validation-for="Comments" class="text-danger"></span></div>
    <button class="btn btn-primary">Submit review</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
