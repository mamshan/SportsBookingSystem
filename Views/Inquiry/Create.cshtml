@model Inquiry
@{ ViewData["Title"] = "Contact the Sports Council"; }
<h1>Contact the Sports Council</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="GuestName"></label><input asp-for="GuestName" class="form-control" /><span asp-validation-for="GuestName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Message"></label><textarea asp-for="Message" rows="4" class="form-control"></textarea><span asp-validation-for="Message" class="text-danger"></span></div>
    <button class="btn btn-primary">Send inquiry</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
