@model BookingViewModel
@{ ViewData["Title"] = "Book a facility"; }
<h1>Book a facility</h1>
<p>Choose a future time slot. Your request will be saved as Pending.</p>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FacilityId"></label><select asp-for="FacilityId" asp-items="ViewBag.Facilities" class="form-select"><option value="">Choose a facility</option></select><span asp-validation-for="FacilityId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="BookingDate"></label><input asp-for="BookingDate" class="form-control" /><span asp-validation-for="BookingDate" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="StartTime"></label><input asp-for="StartTime" class="form-control" /><span asp-validation-for="StartTime" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="EndTime"></label><input asp-for="EndTime" class="form-control" /><span asp-validation-for="EndTime" class="text-danger"></span></div>
    <button class="btn btn-primary">Request booking</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
