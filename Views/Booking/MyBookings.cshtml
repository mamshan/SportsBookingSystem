@model IEnumerable<Booking>
@{ ViewData["Title"] = "My bookings"; }
<h1>My bookings</h1>
<p><a asp-action="Create" class="btn btn-primary">Book a facility</a></p>
@if (!Model.Any()) { <p>You have no bookings yet.</p> }
else
{
    <table class="table table-striped">
        <thead><tr><th>Facility</th><th>Date</th><th>Start</th><th>End</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var booking in Model)
        {
            <tr><td>@booking.Facility.Name</td><td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                <td>@booking.StartTime?.ToString("HH:mm")</td><td>@booking.EndTime?.ToString("HH:mm")</td><td>@booking.Status</td></tr>
        }
        </tbody>
    </table>
}
